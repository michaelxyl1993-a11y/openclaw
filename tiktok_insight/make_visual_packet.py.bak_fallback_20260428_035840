import json
import hashlib
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont

BASE_DIR = Path(__file__).parent
MEDIA_DIR = BASE_DIR / "media"
REPORT_DIR = BASE_DIR / "reports"

def cache_key(text: str) -> str:
    return hashlib.md5(text.encode("utf-8")).hexdigest()

def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))

def make_contact_sheet(frame_paths, output_path: Path, cols=5, thumb_w=216, thumb_h=384):
    images = []

    for idx, path in enumerate(frame_paths, start=1):
        img = Image.open(path).convert("RGB")
        img.thumbnail((thumb_w, thumb_h))

        canvas = Image.new("RGB", (thumb_w, thumb_h + 36), "white")

        x = (thumb_w - img.width) // 2
        y = 0
        canvas.paste(img, (x, y))

        draw = ImageDraw.Draw(canvas)
        label = f"Frame {idx:02d}"
        draw.text((10, thumb_h + 8), label, fill=(0, 0, 0))

        images.append(canvas)

    rows = (len(images) + cols - 1) // cols
    sheet_w = cols * thumb_w
    sheet_h = rows * (thumb_h + 36)

    sheet = Image.new("RGB", (sheet_w, sheet_h), "white")

    for i, img in enumerate(images):
        row = i // cols
        col = i % cols
        sheet.paste(img, (col * thumb_w, row * (thumb_h + 36)))

    sheet.save(output_path, quality=92)

def main():
    input_path = BASE_DIR / "input_test.json"
    payload = read_json(input_path)

    material_url = payload["material_url"].strip()
    key = cache_key(material_url)

    data_packet_path = REPORT_DIR / f"{key}_data_packet.json"
    data_packet = read_json(data_packet_path)

    frame_paths = data_packet.get("video_frames", {}).get("frame_paths", [])

    if not frame_paths:
        raise RuntimeError("No frame paths found in data_packet. Run extract_frames.py first.")

    frame_paths = [Path(p) for p in frame_paths if Path(p).exists()]

    if not frame_paths:
        raise RuntimeError("Frame files do not exist.")

    output_path = REPORT_DIR / f"{key}_contact_sheet.jpg"

    make_contact_sheet(frame_paths, output_path)

    data_packet.setdefault("visual_packet", {})
    data_packet["visual_packet"]["contact_sheet_path"] = str(output_path)
    data_packet["visual_packet"]["frame_count"] = len(frame_paths)

    data_packet_path.write_text(
        json.dumps(data_packet, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )

    print(json.dumps({
        "status": "success",
        "contact_sheet_path": str(output_path),
        "frame_count": len(frame_paths)
    }, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
