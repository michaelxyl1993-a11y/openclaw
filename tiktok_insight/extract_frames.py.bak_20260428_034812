import json
import hashlib
import subprocess
import shutil
from pathlib import Path

BASE_DIR = Path(__file__).parent
MEDIA_DIR = BASE_DIR / "media"
REPORT_DIR = BASE_DIR / "reports"

def cache_key(text: str) -> str:
    return hashlib.md5(text.encode("utf-8")).hexdigest()

def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))

def write_json(path: Path, data):
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

def main():
    if not shutil.which("ffmpeg"):
        raise RuntimeError("ffmpeg not found. Please install with: brew install ffmpeg")

    input_path = BASE_DIR / "input_test.json"
    payload = read_json(input_path)

    material_url = payload["material_url"].strip()
    key = cache_key(material_url)

    data_packet_path = REPORT_DIR / f"{key}_data_packet.json"
    data_packet = read_json(data_packet_path)

    media_path = Path(data_packet.get("media", {}).get("local_path", ""))

    if not media_path.exists():
        raise FileNotFoundError(f"Missing media file: {media_path}")

    frames_dir = MEDIA_DIR / f"{key}_frames"
    frames_dir.mkdir(exist_ok=True)

    duration = data_packet.get("media", {}).get("duration") or 0

    if duration and duration <= 20:
        fps_expr = "fps=1"
    elif duration and duration <= 60:
        fps_expr = "fps=1/3"
    else:
        fps_expr = "fps=1/5"

    output_pattern = str(frames_dir / "frame_%03d.jpg")

    cmd = [
        "ffmpeg",
        "-y",
        "-i", str(media_path),
        "-vf", fps_expr,
        "-q:v", "3",
        output_pattern
    ]

    print("Running:", " ".join(cmd))
    subprocess.run(cmd, check=True)

    frame_paths = sorted(frames_dir.glob("frame_*.jpg"))

    if len(frame_paths) > 30:
        for p in frame_paths[30:]:
            p.unlink()
        frame_paths = frame_paths[:30]

    data_packet.setdefault("data_availability", {})
    data_packet["data_availability"]["video_frames_available"] = len(frame_paths) > 0

    data_packet["video_frames"] = {
        "frames_dir": str(frames_dir),
        "frame_count": len(frame_paths),
        "frame_paths": [str(p) for p in frame_paths],
        "sampling_rule": fps_expr
    }

    write_json(data_packet_path, data_packet)

    print(json.dumps({
        "status": "success",
        "frames_dir": str(frames_dir),
        "frame_count": len(frame_paths),
        "sampling_rule": fps_expr,
        "sample_frames": [str(p) for p in frame_paths[:5]]
    }, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
